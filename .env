# ===== Model =====
ARK_API_KEY=sk-ce09c2e9107d4f248a8b7466021f2911
MODEL=deepseek-v4-flash
# 复杂度规划，以及 Step-back / HyDE 单选重写使用低延迟模型。
FAST_MODEL=deepseek-v4-flash
# 证据相关性、可回答性、歧义和路由评判使用独立的高能力模型。
GRADE_MODEL=deepseek-v4-flash
BASE_URL=https://api.deepseek.com/v1

# ===== 密集向量 Embedding 配置 =====
# 方式 A：远程 HTTP API（配合 Tailscale 访问本地 PC 的 embedding-service 或云端 API）
EMBEDDING_API_URL=http://100.99.91.88:8001/v1/embeddings
EMBEDDING_API_KEY=

# 方式 B：本地下载加载（未设 EMBEDDING_API_URL 时自动使用）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=1024
# Hugging Face 国内镜像源加速
HF_ENDPOINT=https://hf-mirror.com

# ===== Rerank 重排序配置 (配合 embedding-service 或第三方服务) =====
# 示例：配合 Tailscale 访问本地 PC 部署的 embedding-service (端口 8001)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=http://100.99.91.88:8001
RERANK_API_KEY=local
# Rerank 上游最大等待时间；占位符配置会被自动识别为未启用。
RERANK_TIMEOUT_SECONDS=5

# ===== 检索候选池 & Auto-merging =====
# 精排后返回给 Agent 的片段数
RETRIEVAL_TOP_K=8
# Milvus 叶子层召回候选数：设 RETRIEVAL_CANDIDATE_K 时优先使用（且 >= top_k）
# 未设 K 时：candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
# 精排后进入 Agent 的最低分（默认 0，上线后按数据标定）
RERANK_MIN_SCORE=0.0

# ===== Milvus =====
MILVUS_HOST=100.110.219.71
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
# 单次 RPC 超时（秒）；连接按请求创建，不长期占用 gRPC channel
MILVUS_TIMEOUT=30

